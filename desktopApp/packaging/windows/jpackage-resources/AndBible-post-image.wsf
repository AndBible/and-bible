<?xml version="1.0"?>
<job>
<script language="JScript"><![CDATA[
var fs = new ActiveXObject("Scripting.FileSystemObject");
var path = fs.BuildPath(fs.GetParentFolderName(WScript.ScriptFullName), "bundle.wxf");
var xml = new ActiveXObject("Msxml2.DOMDocument.6.0");
xml.async = false;
xml.setProperty("SelectionLanguage", "XPath");
xml.setProperty("SelectionNamespaces", "xmlns:w='http://schemas.microsoft.com/wix/2006/wi'");
if (!xml.load(path)) throw new Error("Cannot load bundle.wxf: " + xml.parseError.reason);
var shortcuts = xml.selectNodes("//w:Shortcut[@Name='AndBible']");
if (shortcuts.length == 0) throw new Error("AndBible shortcut not found in bundle.wxf");
for (var i = 0; i < shortcuts.length; i++) {
    var shortcutProperty = xml.createNode(1, "ShortcutProperty", "http://schemas.microsoft.com/wix/2006/wi");
    shortcutProperty.setAttribute("Key", "System.AppUserModel.ID");
    shortcutProperty.setAttribute("Value", "org.andbible.AndBible");
    shortcuts.item(i).appendChild(shortcutProperty);
    var activatorProperty = xml.createNode(1, "ShortcutProperty", "http://schemas.microsoft.com/wix/2006/wi");
    activatorProperty.setAttribute("Key", "System.AppUserModel.ToastActivatorCLSID");
    activatorProperty.setAttribute("Value", "{C8B03B6B-3F3A-4F8E-9A57-24A610C03A13}");
    shortcuts.item(i).appendChild(activatorProperty);
}
xml.save(path);
]]></script>
</job>
