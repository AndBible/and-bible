    "views": [
      {
        "viewName": "MyDocumentPageWithContent",
        "createSql": "CREATE VIEW `${VIEW_NAME}` AS SELECT p.*, c.content\n    FROM MyDocumentPage p\n    LEFT OUTER JOIN MyDocumentPageContent c ON p.id = c.pageId"
      },
      {
        "viewName": "AiCachedPageWithContent",
        "createSql": "CREATE VIEW `${VIEW_NAME}` AS SELECT c.pageId, c.sourcePromptId, c.sourceContext, c.kjvOrdinalStart,\n           c.kjvOrdinalEnd, c.contextHash, c.usedWriteTools, c.sourceModelName,\n           c.sourceBookInitials, c.sourceBookKey,\n           p.title, p.pageKey, p.contentType, p.documentId,\n           p.orderNumber, p.createdAt, p.updatedAt, p.languageCode, cnt.content\n    FROM AiPageCacheEntry c\n    INNER JOIN MyDocumentPage p ON c.pageId = p.id\n    LEFT OUTER JOIN MyDocumentPageContent cnt ON p.id = cnt.pageId"
      }
    ],
