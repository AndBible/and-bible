# Release signing credentials for AndBible
#
# This is an EXAMPLE file showing the format. To use:
#   1. Copy to keystore.properties:   cp keystore.properties.example keystore.properties
#   2. Fill in your passwords below.
#   3. Encrypt:                        gpg -e -r <your-gpg-id> keystore.properties
#   4. Delete the plaintext:           rm keystore.properties
#   5. Verify it decrypts:             gpg --decrypt keystore.properties.gpg
#
# The encrypted file `keystore.properties.gpg` is safe to commit.
# The plaintext `keystore.properties` is gitignored.
#
# These credentials are used for all non-F-Droid release variants
# (googleplay, github, samsung, huawei, amazon, accrescent),
# including the Accrescent APK-set bundletool flow.

storeFile=/home/tairaksinen/.android/release_keys.jks
storePassword=your_keystore_password_here
keyAlias=andbible
keyPassword=your_key_password_here
