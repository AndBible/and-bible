# Copy to <repo>/ai-local/osticket.env (gitignored). The osticket skill
# stops if that file is missing.
#
# Install: https://github.com/Sykero-Software/ostickethelper
#   git clone https://github.com/Sykero-Software/ostickethelper.git
#   cd ostickethelper && poetry install && poetry run playwright install chromium
# Helper YAML (url, username, password/secrets_file, inbox_dir) is separate —
# do not put SCP passwords in the skill.

OSTICKETHELPER_DIR=/absolute/path/to/ostickethelper
OSTICKET_CONFIG=/absolute/path/to/your/ostickethelper-config.yaml

# Optional: export for ostickethelper if the YAML has no password/secrets_file.
# OSTICKET_PASSWORD=
