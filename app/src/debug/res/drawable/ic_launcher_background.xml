<!--
  Debug-only override of the release icon's plain white background. A debug build installs
  side by side with the real app (applicationIdSuffix), so the two are otherwise
  indistinguishable in the launcher and, more importantly, in the system "open with" chooser —
  which is how a module/StudyPad file reaches the app. The violet says "not the real app" at a
  glance; the foreground's browns and ambers stay legible on it. The build type's own label
  (app_build.gradle.kts's resValue, derived from applicationIdSuffix) says WHICH debug build.
  -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#5E35B1"
        android:pathData="M0,0h108v108h-108z" />
</vector>
