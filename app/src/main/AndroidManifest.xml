<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:installLocation="internalOnly"
    android:versionCode="1117"
    android:versionName="5.1.1117">

    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" android:minSdkVersion="24"/>
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- Remove permissions added by nextcloud android library (we really don't need them!) -->
    <uses-permission android:name="android.permission.GET_ACCOUNTS" tools:node="remove" />
    <uses-permission android:name="android.permission.MANAGE_ACCOUNTS" tools:node="remove" />
    <uses-permission android:name="android.permission.USE_CREDENTIALS" tools:node="remove" />
    <uses-permission android:name="android.permission.AUTHENTICATE_ACCOUNTS" tools:node="remove" />

    <!-- allow use on Google TV -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <!--
      ~ android:enableOnBackInvokedCallback="false" opts out of the predictive back system
      ~ animations that became default-on for apps targeting API 36. Without it the platform
      ~ stops calling Activity.onBackPressed() and stops dispatching KEYCODE_BACK, which would
      ~ break back handling app-wide (see ActivityBase / MainBibleActivity) and silently drop
      ~ the long-press-back shortcut to the History screen.
      ~
      ~ This opt-out is documented as temporary and is expected to stop working at targetSdk 37.
      ~ The migration to OnBackPressedDispatcher is tracked as part of the Compose rewrite: the
      ~ flag can be flipped to "true" per <activity> as screens are ported, and this line removed
      ~ once no legacy activity relies on onBackPressed().
      -->
    <application
        android:name="net.bible.android.BibleApplication"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_descriptor"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        tools:replace="android:label,android:usesCleartextTraffic"
        android:label="@string/app_name_short"
        android:resizeableActivity="true"
        android:theme="@style/AppTheme"
        tools:ignore="GoogleAppIndexingWarning"
        android:supportsRtl="true"
        android:exported="true"
        android:usesCleartextTraffic="false"
        android:enableOnBackInvokedCallback="false"
        >
        <uses-library
            android:name="org.apache.http.legacy"
            android:required="false" />

        <activity android:name=".StartupActivity"
            android:configChanges="keyboardHidden|orientation|screenSize|locale"
            android:icon="@mipmap/ic_launcher" />

        <activity-alias
            android:name="net.bible.android.view.activity.Calculator"
            android:icon="@drawable/ic_calculator_color"
            android:label="@string/app_name_calculator"
            android:enabled="false"
            android:exported="true"
            android:targetActivity=".StartupActivity"
            >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- see Samsung multi-window info at bottom -->
                <category android:name="android.intent.category.MULTIWINDOW_LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity
            android:name="net.bible.android.view.activity.page.MainBibleActivity"
            android:configChanges="keyboard|navigation|keyboardHidden|screenSize|locale"
            android:theme="@style/MainBibleViewTheme"
            android:windowSoftInputMode="stateHidden|adjustPan"
            android:launchMode="singleTop"
            android:label="@string/app_name_short" />
        <activity
            android:name="net.bible.android.view.activity.backup.BackupComposeActivity"
            android:theme="@style/Theme.AbCompose"
            android:configChanges="keyboardHidden|orientation|screenSize|locale"
            android:label="@string/backup_and_restore"
            android:parentActivityName="net.bible.android.view.activity.nav.NavHostComposeActivity"
            />
        <activity
            android:name="net.bible.android.view.activity.navigation.ChooseDocumentComposeActivity"
            android:theme="@style/Theme.AbCompose"
            android:configChanges="keyboardHidden|orientation|screenSize|locale"
            android:label="@string/chooseBook"
            android:windowSoftInputMode="adjustResize"
            android:parentActivityName="net.bible.android.view.activity.nav.NavHostComposeActivity" />
        <activity
            android:name="net.bible.android.view.activity.navigation.GridChoosePassageComposeActivity"
            android:configChanges="keyboardHidden|locale"
            android:theme="@style/Theme.AbCompose" />
        <!-- No android:label: one host serves four clusters, so the window title is set per
             destination via <Cluster>NavDeps.setWindowTitle (nav-graph slices 3/5/6, plan D2).
             The label that used to live here ("@string/ai_settings") was slice 1's M5 fix for
             Recents/TalkBack falling back to the application label; the deps slot replaces it.

             android:launchMode="singleTop" (Task 3 fix round 1, finding I3): HistoryManager
             re-launches a stored intent with FLAG_ACTIVITY_REORDER_TO_FRONT, which matches on the
             COMPONENT alone. With one component serving every cluster, the default "standard" mode
             let a reading-plan history entry reorder an existing AI-cluster instance to the front
             and drop the stored EXTRA_ROUTE, showing an unrelated screen. singleTop routes the
             re-launch into NavHostComposeActivity.onNewIntent, which navigates the live graph to
             the requested route. Spec section 7 #2 sanctions collapsing launchMode to route level. -->
        <activity
            android:name="net.bible.android.view.activity.nav.NavHostComposeActivity"
            android:theme="@style/Theme.AbCompose"
            android:configChanges="keyboardHidden|orientation|screenSize|locale"
            android:windowSoftInputMode="adjustResize"
            android:launchMode="singleTop"
            />
        <!-- reading-host re-typing T8b: this host has NO android:parentActivityName, deliberately.
             It used to name MainBibleActivity, which was harmless while the classic Activity was
             the app's main screen; now that this host IS the main screen (StartupActivity's boot
             handoff opens it on NavRoutes.READING) a parent would have to be itself, and an
             Activity cannot be its own Up target. The other seven parentActivityName attributes
             below were repointed here in the same commit. -->
        <activity
            android:name="net.bible.android.view.activity.navigation.ChooseDictionaryWordComposeActivity"
            android:theme="@style/Theme.AbCompose"
            android:configChanges="keyboardHidden|orientation|screenSize|locale"
            android:label="@string/dictionary"
            android:windowSoftInputMode="adjustResize"
            android:parentActivityName="net.bible.android.view.activity.nav.NavHostComposeActivity" />
        <activity
            android:name="net.bible.android.view.activity.navigation.genbookmap.ChooseGeneralBookKeyComposeActivity"
            android:theme="@style/Theme.AbCompose"
            android:configChanges="keyboardHidden|orientation|screenSize|locale"
            android:label="@string/general_book"
            android:parentActivityName="net.bible.android.view.activity.nav.NavHostComposeActivity" />
        <activity
            android:name="net.bible.android.view.activity.navigation.genbookmap.ChooseMapKeyComposeActivity"
            android:theme="@style/Theme.AbCompose"
            android:configChanges="keyboardHidden|orientation|screenSize|locale"
            android:label="@string/doc_type_map"
            android:parentActivityName="net.bible.android.view.activity.nav.NavHostComposeActivity" />
        <activity
            android:name=".view.activity.StartupComposeActivity"
            android:theme="@style/Theme.AbCompose"
            android:exported="false" />
        <activity
            android:name="net.bible.android.view.activity.workspaces.WorkspaceSelectorComposeActivity"
            android:theme="@style/Theme.AbCompose"
            android:configChanges="keyboardHidden|orientation|screenSize|locale"
            android:label="@string/workspace_selector_title"
            android:parentActivityName="net.bible.android.view.activity.nav.NavHostComposeActivity"
            />
        <activity
            android:name="net.bible.android.view.activity.settings.TextDisplaySettingsComposeActivity"
            android:theme="@style/Theme.AbCompose"
            android:configChanges="keyboardHidden|orientation|screenSize|locale"
            android:label="@string/text_display_settings_activity_title"
            android:parentActivityName="net.bible.android.view.activity.nav.NavHostComposeActivity" />
        <!--
          ~ The two activities below (InstallZipComposeActivity and CalculatorComposeActivity) are
          ~ the only ones that lock screenOrientation. From API 36
          ~ onwards the platform ignores screenOrientation/resizableActivity/min-maxAspectRatio on
          ~ displays with smallestWidth >= 600dp, so the portrait lock would stop applying on
          ~ tablets and unfolded foldables. PROPERTY_COMPAT_ALLOW_RESTRICTED_RESIZABILITY keeps
          ~ the current behaviour.
          ~
          ~ Like the predictive back opt-out above this is temporary — it is ignored from targetSdk 37.
          ~ The real fix is layouts that work in landscape on a large screen; CalculatorComposeActivity in
          ~ particular is the discrete build's disguise, so its landscape appearance has to be
          ~ credible before the lock can be dropped.
          -->
        <activity
            android:name="net.bible.android.view.activity.installzip.InstallZipComposeActivity"
            android:label="@string/install_zip_module"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.AbCompose"
            android:exported="true"
            >
            <property
                android:name="android.window.PROPERTY_COMPAT_ALLOW_RESTRICTED_RESIZABILITY"
                android:value="true" />
        </activity>
        <activity
            android:name="net.bible.android.view.activity.discrete.CalculatorComposeActivity"
            android:label="@string/app_name_calculator"
            android:screenOrientation="portrait"
            >
            <property
                android:name="android.window.PROPERTY_COMPAT_ALLOW_RESTRICTED_RESIZABILITY"
                android:value="true" />
        </activity>
        <activity
            android:name="net.bible.android.view.activity.base.ErrorActivity"
            android:label="@string/error_occurred"
            android:exported="true"
            />
        <service
            android:name="net.bible.service.cloudsync.SyncService"
            android:foregroundServiceType="dataSync" />

        <service
            android:name="net.bible.service.cloudsync.documents.DocumentSyncService"
            android:foregroundServiceType="dataSync" />

        <service
            android:name="net.bible.service.device.speak.TextToSpeechNotificationManager$ForegroundService"
            android:foregroundServiceType="mediaPlayback" />

        <service
            android:name="net.bible.service.llm.agent.AgentForegroundService"
            android:foregroundServiceType="dataSync" />

        <service
            android:name="net.bible.service.installzip.DocumentInstallService"
            android:foregroundServiceType="dataSync" />

        <receiver
            android:name="net.bible.service.device.speak.TextToSpeechNotificationManager$NotificationReceiver"
            android:exported="true" />

        <receiver android:name="net.bible.service.device.speak.AndBibleMediaButtonReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

        <!-- allow use with Samsung Note multi-window http://stackoverflow.com/questions/14111052/adding-multi-window-support-to-android-application -->
        <uses-library
            android:name="com.sec.android.app.multiwindow"
            android:required="false" />

        <meta-data
            android:name="com.sec.android.support.multiwindow"
            android:value="true" />
        <meta-data
            android:name="com.sec.android.multiwindow.DEFAULT_SIZE_W"
            android:value="632.0dip" />
        <meta-data
            android:name="com.sec.android.multiwindow.DEFAULT_SIZE_H"
            android:value="598.0dip" />
        <meta-data
            android:name="com.sec.android.multiwindow.MINIMUM_SIZE_W"
            android:value="632.0dip" />
        <meta-data
            android:name="com.sec.android.multiwindow.MINIMUM_SIZE_H"
            android:value="598.0dip" />
        <provider
            android:authorities="${applicationId}.provider"
            android:name="androidx.core.content.FileProvider"
            android:exported="false"
            android:grantUriPermissions="true"
            >
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"
                />
        </provider>
    </application>
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
    </queries>
</manifest> 
