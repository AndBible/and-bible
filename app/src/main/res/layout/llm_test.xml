<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="LLM Tools Test Suite"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Read Tools Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Read Tools"
                android:textStyle="bold"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="4dp" />

            <Button
                android:id="@+id/btnGetVerseContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="getVerseContent (Matt.5.3)"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btnGetAllLabels"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="getAllLabels"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btnSearchBookmarks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="searchBookmarks"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btnGetBookmarkById"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="getBookmarkById (from first bookmark)"
                android:textAllCaps="false" />

            <!-- Write Tools Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Write Tools"
                android:textStyle="bold"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="4dp" />

            <Button
                android:id="@+id/btnCreateBookmark"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="createBookmark (John.3.16)"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btnCreateLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="createLabel (LLM Test Label)"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btnAddStudyPadEntry"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="addStudyPadEntry"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btnAddBookmarkNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="addBookmarkNote"
                android:textAllCaps="false" />

            <!-- LLM-Driven Tests Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LLM-Driven Tests"
                android:textStyle="bold"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="4dp" />

            <Button
                android:id="@+id/btnLlmCreateBookmark"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="LLM: Create bookmark with note"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btnLlmListLabels"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="LLM: List and describe labels"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btnLlmReadAndSummarize"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="LLM: Read verse and summarize"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btnLlmCreateLabelWithEntry"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="LLM: Create label + StudyPad entry"
                android:textAllCaps="false" />

            <!-- Custom Prompt Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Custom Prompt"
                android:textStyle="bold"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/customPromptInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minLines="3"
                android:maxLines="6"
                android:gravity="top"
                android:hint="Enter your prompt here..."
                android:inputType="textMultiLine"
                android:background="@android:drawable/edit_text"
                android:padding="8dp" />

            <Button
                android:id="@+id/btnRunCustomPrompt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Run Custom Prompt"
                android:textAllCaps="false" />

            <!-- Agent Test Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Agent Execution (DB Prompt)"
                android:textStyle="bold"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="4dp" />

            <Button
                android:id="@+id/btnRunAgent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Run Agent (first prompt from DB)"
                android:textAllCaps="false" />

            <!-- Cleanup Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cleanup"
                android:textStyle="bold"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="4dp" />

            <Button
                android:id="@+id/btnCleanupTestData"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Delete test bookmarks/labels"
                android:textAllCaps="false" />

        </LinearLayout>
    </ScrollView>

    <!-- Results area -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Results:"
        android:textStyle="bold"
        android:layout_marginTop="16dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:background="#E0E0E0"
        android:padding="8dp">

        <TextView
            android:id="@+id/resultText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textSize="12sp"
            android:text="Press a button to run a test..." />

    </ScrollView>

    <Button
        android:id="@+id/btnClearResults"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:text="Clear"
        android:layout_marginTop="8dp" />

</LinearLayout>
