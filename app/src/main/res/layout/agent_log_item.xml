<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="8dp"
    android:gravity="center_vertical">

    <!-- Type indicator icon -->
    <ImageView
        android:id="@+id/typeIcon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginEnd="8dp"
        app:srcCompat="@drawable/ic_info_24dp" />

    <!-- Message and details container -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Message -->
        <TextView
            android:id="@+id/messageText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp" />

        <!-- Details (optional, shown when expanded or for errors) -->
        <TextView
            android:id="@+id/detailsText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:alpha="0.7"
            android:visibility="gone"
            android:maxLines="3"
            android:ellipsize="end" />

        <!-- Raw LLM log link (separate tappable area) -->
        <TextView
            android:id="@+id/rawLogLink"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:textStyle="italic"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true"
            android:text="@string/agent_log_view_raw"
            android:background="?attr/selectableItemBackground" />
    </LinearLayout>

    <!-- Cost info (right-aligned, small) -->
    <TextView
        android:id="@+id/costText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:textSize="10sp"
        android:alpha="0.6"
        android:visibility="gone" />

    <!-- Status indicator -->
    <ImageView
        android:id="@+id/statusIcon"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginStart="4dp" />

</LinearLayout>
