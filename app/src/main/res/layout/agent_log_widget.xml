<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:elevation="8dp">

    <!-- Top divider line -->
    <View
        android:id="@+id/topDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?android:attr/listDivider" />

    <!-- Header with drag handle and status -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp">

        <!-- Drag handle / Toggle expand button. Wrapped in a FrameLayout so the touch
             zone extends slightly beyond the visible icon — without enlarging the icon —
             so off-by-a-few-pixel taps still reach the button instead of being captured
             by the adjacent clickable statusIcon/statusText. -->
        <FrameLayout
            android:id="@+id/expandButtonContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="6dp">

            <ImageButton
                android:id="@+id/expandButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/agent_log_expand"
                app:srcCompat="@drawable/ic_expand_less_24" />
        </FrameLayout>

        <!-- Status icon (robot) -->
        <ImageView
            android:id="@+id/statusIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="8dp"
            app:srcCompat="@drawable/icon_robot" />

        <!-- Status text -->
        <TextView
            android:id="@+id/statusText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:textSize="14sp"
            android:text="@string/agent_log_idle"
            android:ellipsize="end"
            android:maxLines="1" />

        <!-- Session cost (visible in collapsed header) -->
        <TextView
            android:id="@+id/headerCostText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:textSize="11sp"
            android:alpha="0.6"
            android:visibility="gone" />

        <!-- Close button. Wrapped in a FrameLayout so the touch zone extends slightly
             beyond the visible icon — without enlarging the icon — so off-by-a-few-pixel
             taps still close the widget instead of being captured by the adjacent
             clickable statusText (which would toggle expand/collapse). -->
        <FrameLayout
            android:id="@+id/closeButtonContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="6dp">

            <ImageButton
                android:id="@+id/closeButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/agent_log_close"
                app:srcCompat="@drawable/ic_baseline_close_24" />
        </FrameLayout>
    </LinearLayout>

    <!-- Log entries RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/logRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:visibility="gone" />

</LinearLayout>
