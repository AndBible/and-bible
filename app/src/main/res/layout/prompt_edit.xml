<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Built-in prompt notice (hidden by default) -->
        <TextView
            android:id="@+id/builtInNotice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="?android:attr/colorControlHighlight"
            android:padding="12dp"
            android:text="@string/built_in_prompt_notice"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:visibility="gone" />

        <!-- Name -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/prompt_name"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/promptName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:inputType="text"
            android:singleLine="true" />

        <!-- Description -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/prompt_description"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/promptDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:inputType="text"
            android:singleLine="true" />

        <!-- Prompt Template -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/prompt_template"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/promptTemplate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:gravity="top"
            android:inputType="textMultiLine"
            android:minLines="5" />

        <!-- Edit before run -->
        <CheckBox
            android:id="@+id/checkEditBeforeRun"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/prompt_edit_before_run" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginBottom="16dp"
            android:text="@string/prompt_edit_before_run_description"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:textColor="?android:attr/textColorSecondary" />

        <!-- Show in contexts -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/prompt_show_in"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:textStyle="bold" />

        <CheckBox
            android:id="@+id/checkVerseSelection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/prompt_context_verse_selection" />

        <CheckBox
            android:id="@+id/checkTextSelection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/prompt_context_text_selection" />

        <CheckBox
            android:id="@+id/checkWindowMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/prompt_context_window_menu" />

        <CheckBox
            android:id="@+id/checkWorkspaceMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/prompt_context_workspace_menu" />

        <CheckBox
            android:id="@+id/checkNoteEditor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/prompt_context_note_editor" />

        <!-- Permission mode -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:text="@string/prompt_permission_mode"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/permissionModeSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp" />

        <!-- Per-prompt tool permissions -->
        <Button
            android:id="@+id/btnPromptToolPermissions"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start|center_vertical"
            android:textAllCaps="false" />

        <!-- Provider override -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:text="@string/prompt_provider_override"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/providerOverrideSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- Model override -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:text="@string/prompt_model_override"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/modelOverrideSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <EditText
            android:id="@+id/modelOverrideCustomInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:hint="@string/prompt_model_custom_hint"
            android:inputType="text"
            android:singleLine="true"
            android:visibility="gone" />

        <!-- Cache settings -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:text="@string/prompt_cache_settings"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:textStyle="bold" />

        <CheckBox
            android:id="@+id/checkStrictContextMatching"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/prompt_strict_context_matching" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:text="@string/prompt_strict_context_matching_description"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:textColor="?android:attr/textColorSecondary" />

    </LinearLayout>

</ScrollView>
