<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Built-in prompt notice (hidden by default) -->
    <TextView
        android:id="@+id/builtInNotice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/colorControlHighlight"
        android:padding="12dp"
        android:text="@string/built_in_prompt_notice"
        android:textAppearance="?android:attr/textAppearanceSmall"
        android:visibility="gone" />

    <!-- Tab selector -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:tabMode="fixed"
        app:tabGravity="fill" />

    <!-- Tab 1: Prompt (basic settings) -->
    <ScrollView
        android:id="@+id/promptContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Name -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/prompt_name"
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/promptName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:inputType="text"
                android:singleLine="true" />

            <!-- Description -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/prompt_description"
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/promptDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:inputType="text"
                android:singleLine="true" />

            <!-- Prompt Template -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/prompt_template"
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/promptTemplate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:gravity="top"
                android:inputType="textMultiLine"
                android:minLines="5" />

            <!-- Category -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/prompt_category"
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/categorySpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp" />

            <!-- Show in contexts -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/prompt_show_in"
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:textStyle="bold" />

            <CheckBox
                android:id="@+id/checkBibleOnly"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="@string/prompt_bible_only" />

            <CheckBox
                android:id="@+id/checkVerseSelection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/prompt_context_verse_selection" />

            <CheckBox
                android:id="@+id/checkTextSelection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/prompt_context_text_selection" />

            <CheckBox
                android:id="@+id/checkWindowMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/prompt_context_window_menu" />

            <CheckBox
                android:id="@+id/checkWorkspaceMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/prompt_context_workspace_menu" />

            <CheckBox
                android:id="@+id/checkNoteEditor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/prompt_context_note_editor" />

            <CheckBox
                android:id="@+id/checkTextTransformation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/prompt_is_text_transformation" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="32dp"
                android:text="@string/prompt_is_text_transformation_description"
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:textColor="?android:attr/textColorSecondary" />

        </LinearLayout>
    </ScrollView>

    <!-- Tab 2: Permissions -->
    <ScrollView
        android:id="@+id/permissionsContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Permission mode -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/prompt_permission_mode"
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/permissionModeSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="@string/prompt_permission_mode_description"
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:textColor="?android:attr/textColorSecondary" />

            <!-- Tool permissions list (built by ToolPermissionListBuilder) -->
            <LinearLayout
                android:id="@+id/toolListContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- Reset all button -->
            <Button
                android:id="@+id/btnResetToolPermissions"
                style="?attr/borderlessButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/reset_all_permissions"
                android:textAllCaps="false" />

        </LinearLayout>
    </ScrollView>

    <!-- Tab 3: Advanced (PreferenceFragment container) -->
    <FrameLayout
        android:id="@+id/advancedContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

</LinearLayout>
