<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    android:key="ai_connection_settings">

    <PreferenceCategory
        android:key="ai_providers_category"
        android:title="@string/ai_providers_category">

        <Preference android:key="ai_getting_started"
            android:title="@string/easy_setup_title"
            android:summary="@string/easy_setup_pref_summary"
            android:icon="@drawable/ic_baseline_cloud_24"
            />

        <!-- Dynamic provider items are inserted here programmatically -->

        <Preference android:key="ai_add_provider"
            android:title="@string/ai_add_provider"
            android:summary="@string/ai_add_provider_summary"
            android:icon="@drawable/ic_baseline_cloud_24"
            />
    </PreferenceCategory>

    <PreferenceCategory
        android:key="ai_models_category"
        android:title="@string/ai_models_category">

        <!-- Dynamic model items are inserted here programmatically -->

        <Preference android:key="ai_add_model"
            android:title="@string/add_model"
            android:summary="@string/ai_add_model_summary"
            android:icon="@drawable/ic_baseline_cloud_24"
            />
    </PreferenceCategory>

    <PreferenceCategory
        android:key="ai_behavior_category"
        android:title="@string/ai_behavior_category">

        <ListPreference android:key="agent_permission_mode"
            android:title="@string/prompt_permission_mode"
            android:summary="@string/agent_permission_mode_summary"
            android:entries="@array/agent_permission_mode_entries"
            android:entryValues="@array/agent_permission_mode_values"
            android:defaultValue="ALWAYS_ASK"
            android:icon="@drawable/ic_baseline_security_24"
            />
        <Preference android:key="manage_tool_permissions"
            android:title="@string/manage_tool_permissions_title"
            android:summary="@string/manage_tool_permissions_summary"
            android:icon="@drawable/ic_baseline_security_24"
            />
        <Preference android:key="manage_ai_documents"
            android:title="@string/ai_document_filter_title"
            android:summary="@string/ai_document_filter_summary"
            android:icon="@drawable/ic_baseline_description_gray_24"
            />
        <Preference android:key="commentary_max_response_chars"
            android:title="@string/commentary_max_response_title"
            android:summary="@string/commentary_max_response_summary"
            android:icon="@drawable/ic_baseline_description_gray_24"
            />
        <Preference android:key="agent_max_iterations"
            android:title="@string/agent_max_iterations_title"
            android:summary="@string/agent_max_iterations_summary"
            android:icon="@drawable/ic_baseline_description_gray_24"
            />
    </PreferenceCategory>

    <PreferenceCategory
        android:key="ai_usage_category"
        android:title="@string/ai_usage_category">

        <Preference android:key="llm_usage_summary"
            android:title="@string/llm_usage_summary_title"
            android:summary="@string/llm_usage_summary_default"
            android:selectable="false"
            android:icon="@drawable/ic_baseline_description_gray_24"
            />
        <Preference android:key="llm_reset_usage"
            android:title="@string/llm_reset_usage_title"
            android:summary="@string/llm_reset_usage_summary"
            android:icon="@drawable/ic_baseline_refresh_gray_24"
            />
    </PreferenceCategory>

</PreferenceScreen>
