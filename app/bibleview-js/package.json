{
  "name": "bibleview-js",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check build-only",
    "preview": "vite preview",
    "test:unit": "vitest --config ../vitest.config.mts --root src/",
    "build-only": "vite build",
    "type-check": "vue-tsc -p tsconfig.json",
    "type-check:ci": "vue-tsc -p tsconfig.json",
    "lint": "eslint .",
    "lint-fix": "eslint --fix .",
    "build-debug": "cross-env NODE_ENV=debug vite build --mode debug",
    "build-production": "cross-env NODE_ENV=production vite build --mode production",
    "build-development": "cross-env NODE_ENV=development vite build --mode development",
    "lint:ci": "eslint . --no-color",
    "lint:silent": "eslint . --no-color",
    "test:ci": "vitest --config ../vitest.config.mts --root src/ --run",
    "test:ios-webkit": "node ios/webkit/run-webkit-test.mjs"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "~7.3.1",
    "@fortawesome/free-regular-svg-icons": "~7.3.1",
    "@fortawesome/free-solid-svg-icons": "~7.3.1",
    "@fortawesome/vue-fontawesome": "~3.3.3",
    "@vue/runtime-core": "~3.5.17",
    "color": "~5.0.3",
    "dompurify": "~3.4.17",
    "lodash": "~4.18.1",
    "marked": "~18.1.2",
    "mitt": "~3.0.1",
    "sprintf-js": "~1.1.3",
    "vue": "~3.5.17",
    "vuedraggable": "~4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "~10.0.1",
    "@types/jsdom": "~30.0.0",
    "@types/lodash": "~4.17.27",
    "@types/node": "~24.19.2",
    "@types/sprintf-js": "~1.1.4",
    "@typescript-eslint/eslint-plugin": "~8.72.1",
    "@typescript-eslint/parser": "~8.72.1",
    "@vitejs/plugin-vue": "~6.0.10",
    "@vue/compiler-sfc": "~3.5.17",
    "@vue/eslint-config-typescript": "~14.9.0",
    "@vue/reactivity": "~3.5.17",
    "@vue/test-utils": "~2.4.6",
    "@vue/tsconfig": "~0.9.1",
    "cross-env": "~10.1.0",
    "eslint": "~10.14.0",
    "eslint-plugin-vue": "~10.12.0",
    "globals": "~17.13.0",
    "js-yaml": "~5.5.0",
    "jsdom": "~30.1.3",
    "npm": "~11.21.1",
    "npm-run-all": "~4.1.5",
    "playwright": "1.64.1",
    "sass": "~1.107.1",
    "tosource": "~2.0.0-alpha.3",
    "typescript": "~6.0.3",
    "vite": "~8.3.5",
    "vitest": "~5.0.5",
    "vue-tsc": "~3.3.14"
  }
}
